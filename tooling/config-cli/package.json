{
  "name": "@holon/config-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "holon": "node --import tsx cli.ts",
    "schema:generate": "node --import tsx schema.ts",
    "schema:check": "node --import tsx schema.ts --check",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@holon/application": "workspace:*",
    "@holon/contracts": "workspace:*",
    "@holon/repository-analysis": "workspace:*",
    "@holon/repository-config": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "8.20.0",
    "oxfmt": "catalog:",
    "tsx": "catalog:",
    "vscode-languageserver-textdocument": "1.0.14",
    "vscode-languageserver-types": "3.18.3",
    "yaml-language-server": "1.24.0"
  }
}
