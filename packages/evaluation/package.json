{
  "name": "@holon/evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./corpus": "./corpus/v2/index.ts",
    "./corpus/v1": "./corpus/v1/index.ts",
    "./corpus/v2": "./corpus/v2/index.ts",
    "./corpus/v3": "./corpus/v3/index.ts",
    "./recordings": "./recordings/v2/index.ts",
    "./recordings/v1": "./recordings/v1/index.ts",
    "./recordings/v2": "./recordings/v2/index.ts",
    "./recordings/v3": "./recordings/v3/index.ts"
  },
  "scripts": {
    "evaluate:live": "tsx src/cli.ts live",
    "evaluate:recorded": "tsx src/cli.ts recorded",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "evaluate:identification": "tsx src/identification-cli.ts"
  },
  "dependencies": {
    "@holon/application": "workspace:*",
    "@holon/contracts": "workspace:*",
    "@holon/domain": "workspace:*",
    "@holon/model": "workspace:*",
    "@holon/project-identification": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@holon/test-kit": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
