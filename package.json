{
  "name": "holon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:check": "node tooling/brand/tokens.mjs --check",
    "brand:generate": "node tooling/brand/tokens.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "pnpm test:deploy && turbo run test",
    "test:coverage": "pnpm test:deploy:coverage && turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm config:schema:check && pnpm config:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "config:validate": "pnpm --filter @holon/config-cli holon config validate",
    "config:explain": "pnpm --filter @holon/config-cli holon config explain",
    "config:schema:generate": "pnpm --filter @holon/config-cli schema:generate",
    "config:schema:check": "pnpm --filter @holon/config-cli schema:check",
    "test:deploy": "node --test tooling/deploy/*.test.mjs",
    "test:deploy:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-include=\"tooling/deploy/*.mjs\" --test-coverage-exclude=\"tooling/deploy/*.test.mjs\" tooling/deploy/*.test.mjs",
    "deploy:guarded": "node tooling/deploy/cli.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0"
}
