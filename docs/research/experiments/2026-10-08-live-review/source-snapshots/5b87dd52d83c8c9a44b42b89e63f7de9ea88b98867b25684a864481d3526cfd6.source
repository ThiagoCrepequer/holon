/** Fresh confirmation after the causal-context change; labels fixed before inference. */
export const liveConfirmationFixtures = [true, false]
  .flatMap((positive) => [
    {
      id: `payload-field.${positive ? "positive" : "negative"}`,
      family: "payload-field",
      positive,
      baseProducer:
        'export function payload() {\n  return { name: "ok", value: 1 };\n}',
      headProducer: 'export function payload() {\n  return { name: "ok" };\n}',
      consumer: `import { payload } from "./producer.ts";\nexport function run() {\n  const total = ${positive ? "payload().value" : "(payload().value ?? 1)"} + 1;\n  if (!Number.isFinite(total)) throw new Error("INVALID_AMOUNT");\n  return total;\n}`,
    },
    {
      id: `inclusive-boundary.${positive ? "positive" : "negative"}`,
      family: "inclusive-boundary",
      positive,
      baseProducer:
        "export function allows(bytes: number, maximum: number) {\n  return bytes <= maximum;\n}",
      headProducer:
        "export function allows(bytes: number, maximum: number) {\n  return bytes < maximum;\n}",
      consumer: `import { allows } from "./producer.ts";\nexport function run() {\n  const submittedBytes = ${positive ? "10" : "9"};\n  if (!allows(submittedBytes, 10)) throw new Error("BOUNDARY_REJECTED");\n  return "accepted";\n}`,
    },
  ])
  .map((fixture, index) => ({
    ...fixture,
    prNumber: index + 9,
    files: {
      "src/producer.ts": fixture.headProducer,
      "src/consumer.ts": fixture.consumer,
      ...Object.fromEntries(
        Array.from({ length: 4 }, (_, i) => [
          `src/unrelated-${i}.ts`,
          `export function unrelated${i}(value: number) { return value + ${i}; }`,
        ]),
      ),
    } as Readonly<Record<string, string>>,
    patch: `diff --git a/src/producer.ts b/src/producer.ts\n--- a/src/producer.ts\n+++ b/src/producer.ts\n@@ -1,3 +1,3 @@\n ${fixture.baseProducer.split("\n")[0]}\n-${fixture.baseProducer.split("\n")[1]}\n+${fixture.headProducer.split("\n")[1]}\n }`,
  }));
