import { spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { unlinkSync } from "node:fs";
import {
  mkdir,
  mkdtemp,
  open,
  readFile,
  rename,
  rm,
  writeFile,
} from "node:fs/promises";
import { createServer, type IncomingMessage } from "node:http";
import { tmpdir } from "node:os";
import { relative, resolve } from "node:path";
import { parseEnv } from "node:util";

import { runIdSchema, executorRequestSchema } from "@holon/contracts";
import { z } from "zod";

import { buildReviewArtifacts } from "../../repository-executor/src/review-context.js";
import { LiveBenchmarkBudget } from "./live-benchmark-budget.js";
import {
  assertLiveBenchmarkResume,
  liveBenchmarkExitCode,
} from "./live-benchmark-policy.js";
import { finalValidationMetadata } from "./live-final-validation.js";
import {
  commitFixture,
  prepareFixtureInventory,
} from "./live-fixture-context.mjs";
import {
  LiveFixtureExecutor,
  validateFixtureOracle,
  fixtureImageDigest,
} from "./live-fixture-executor.mjs";
import {
  liveBenchmarkPlan,
  liveFixtures,
  liveVariants,
} from "./live-fixtures.js";
import { LiveModelSpend, modelSpendPolicy } from "./live-model-spend.js";

const credentialFile = process.env.HOLON_BENCH_CREDENTIAL_FILE;
if (!credentialFile)
  throw new Error(
    "Set HOLON_BENCH_CREDENTIAL_FILE to an authorized local credential file",
  );
const variables = parseEnv(await readFile(credentialFile, "utf8"));
const config = z
  .strictObject({
    accountId: z.string().regex(/^[a-f0-9]{32}$/u),
    gatewayId: z.string().regex(/^[A-Za-z0-9_-]{1,64}$/u),
    token: z.string().min(1),
  })
  .parse({
    accountId:
      process.env.AI_GATEWAY_ACCOUNT_ID ?? variables.AI_GATEWAY_ACCOUNT_ID,
    gatewayId: process.env.AI_GATEWAY_ID ?? variables.AI_GATEWAY_ID,
    token: variables.AI_GATEWAY_API_TOKEN ?? variables.CLOUDFLARE_API_TOKEN,
  });
const probe = process.argv.includes("--probe");
const qualityCheck = process.argv.includes("--quality-check");
const thinking = process.argv.includes("--thinking");
const structuralContext = process.argv.includes("--structural-context");
if (thinking && !qualityCheck)
  throw new Error(
    "Thinking experiment requires the bounded quality-check profile",
  );
const limits = qualityCheck
  ? {
      calls: 24,
      inputBytes: 600_000,
      outputTokens: 50_000,
      requestMs: 45_000,
      suiteMs: 6 * 60_000,
    }
  : liveBenchmarkPlan.limits;
const outputDirectory = resolve(
  "../../artifacts/evaluation",
  `live-${new Date().toISOString().replaceAll(":", "-")}${probe ? "-probe" : ""}`,
);
await mkdir(outputDirectory, { recursive: true });
const spendPath = resolve("../../artifacts/evaluation/live-spend.json");
const spendLockPath = spendPath + ".lock";
const spendLock = await open(spendLockPath, "wx");
process.once("exit", () => {
  unlinkSync(spendLockPath);
});
const spendRecordSchema = z.strictObject({
  id: z.string().min(1),
  reservedNanodollars: z.number().int().positive(),
  chargedNanodollars: z.number().int().nonnegative().optional(),
});
let spend: LiveModelSpend;
try {
  const saved = z
    .strictObject({
      policy: z.record(z.string(), z.number()),
      records: z.array(spendRecordSchema),
      exposureNanodollars: z.number().int().nonnegative(),
    })
    .parse(JSON.parse(await readFile(spendPath, "utf8")));
  if (JSON.stringify(saved.policy) !== JSON.stringify(modelSpendPolicy))
    throw new Error("Campaign price policy changed");
  spend = new LiveModelSpend(saved.records);
  if (spend.snapshot().exposureNanodollars !== saved.exposureNanodollars)
    throw new Error("Campaign spending totals disagree");
} catch (error) {
  if (
    !(error instanceof Error) ||
    !("code" in error) ||
    error.code !== "ENOENT"
  )
    throw error;
  spend = new LiveModelSpend([]);
  // The partial attempt is already included in ablation. Unknown historic cost stays reserved.
  for (const name of [
    "diagnostic-probe",
    "ablation",
    "context-rejected",
    "thinking",
  ]) {
    const historic = z
      .looseObject({
        modelEvents: z.array(
          z.looseObject({
            inputBytes: z.number().int().positive(),
            maxOutputTokens: z.number().int().positive(),
            cost: z.number().nonnegative().optional(),
          }),
        ),
      })
      .parse(
        JSON.parse(
          await readFile(
            resolve(
              `../../docs/research/experiments/2026-10-08-live-review/${name}/results.json`,
            ),
            "utf8",
          ),
        ),
      );
    for (const [index, event] of historic.modelEvents.entries()) {
      const id = `${name}:${index}`;
      if (!spend.reserve(id, event.inputBytes, event.maxOutputTokens))
        throw new Error(
          "Historic campaign exposure exceeds the authorized cap",
        );
      if (event.cost !== undefined) spend.settle(id, event.cost);
    }
  }
}
let spendWrites = Promise.resolve();
const persistSpend = () => {
  spendWrites = spendWrites.then(async () => {
    await writeFile(
      spendPath + ".tmp",
      JSON.stringify(spend.snapshot(), null, 2) + "\n",
    );
    await rename(spendPath + ".tmp", spendPath);
  });
  return spendWrites;
};
await persistSpend();
const fixtureRoot = await mkdtemp(resolve(tmpdir(), "holon-live-fixtures-"));
const budget = new LiveBenchmarkBudget(limits);
const resultSchema = z.looseObject({
  caseId: z.enum(liveFixtures.map((item) => item.id)),
  variant: z.enum(liveVariants),
  runId: runIdSchema,
  passed: z.boolean(),
  expectedDefect: z.boolean(),
  failure: z.string().nullable(),
  durationMs: z.number().nonnegative(),
});
const requestSchema = z.looseObject({
  model: z.literal(liveBenchmarkPlan.route),
  stream: z.literal(true),
  max_tokens: z.number().int().positive().max(12_000),
});
const runSchema = z.strictObject({ runId: runIdSchema });
const eventSchema = z.looseObject({
  status: z.number().int().nonnegative(),
  inputBytes: z.number().int().positive(),
  maxOutputTokens: z.number().int().positive().max(12_000),
  durationMs: z.number().nonnegative(),
  firstByteMs: z.number().nonnegative().optional(),
  model: z.string().optional(),
  inputTokens: z.number().nonnegative().optional(),
  outputTokens: z.number().nonnegative().optional(),
  reasoningTokens: z.number().nonnegative().optional(),
  cost: z.number().nonnegative().optional(),
  spendId: z.string().optional(),
  returnedTools: z.array(z.string()).optional(),
  finishReason: z.string().optional(),
  streamDone: z.boolean().optional(),
  providerErrorHints: z.array(z.string()).optional(),
  finalValidation: z.unknown().optional(),
  phase: z.enum(["investigation", "causal_verification"]).optional(),
  toolChoice: z.unknown().optional(),
  toolNames: z.array(z.string()).optional(),
});
const runs = new Map<
  string,
  { executor: LiveFixtureExecutor; variant: string; caseId: string }
>();
const results: unknown[] = [];
const modelEvents: Array<z.infer<typeof eventSchema>> = [];
const resumePath = process.env.HOLON_BENCH_RESUME_RESULTS;
const previous = resumePath
  ? z
      .looseObject({
        configuration: z.looseObject({
          profile: z.enum(["quality-check", "ablation"]),
          structuralContext: z.boolean(),
          thinking: z.boolean(),
          costPolicy: z.record(z.string(), z.number()),
          probe: z.boolean(),
          limits: z.record(z.string(), z.number()),
          cases: z.array(z.unknown()),
          variants: z.array(z.string()),
          sourceDigests: z.record(z.string(), z.string()),
          routeDeployment: z.string().nullable(),
          imageDigest: z.string(),
        }),
        results: z.array(resultSchema),
        modelEvents: z.array(eventSchema),
      })
      .parse(JSON.parse(await readFile(resumePath, "utf8")))
  : null;
const oracles = [];
const imageDigest = await fixtureImageDigest();
const preparedFixtures = new Map<
  string,
  {
    headSha: string;
    baseSha: string;
    inventory: Awaited<ReturnType<typeof prepareFixtureInventory>>;
  }
>();
for (const fixture of liveFixtures) {
  const head = resolve(fixtureRoot, fixture.id, "head");
  const base = resolve(fixtureRoot, fixture.id, "base");
  for (const [directory, files] of [
    [head, fixture.files],
    [base, { ...fixture.files, "src/producer.ts": fixture.baseProducer }],
  ] as const) {
    await mkdir(resolve(directory, "src"), { recursive: true });
    await Promise.all(
      Object.entries(files).map(([path, content]) =>
        writeFile(resolve(directory, path), content),
      ),
    );
  }
  oracles.push({
    caseId: fixture.id,
    base: await validateFixtureOracle(base, false),
    head: await validateFixtureOracle(head, fixture.positive),
  });
  if (structuralContext)
    preparedFixtures.set(fixture.id, {
      headSha: await commitFixture(head),
      baseSha: await commitFixture(base),
      inventory: await prepareFixtureInventory(
        head,
        fixture.files,
        fixture.patch,
        imageDigest,
      ),
    });
}

const routeResponse = await fetch(
  `https://api.cloudflare.com/client/v4/accounts/${config.accountId}/ai-gateway/gateways/${config.gatewayId}/routes`,
  {
    headers: { Authorization: `Bearer ${config.token}` },
    signal: AbortSignal.timeout(15_000),
  },
);
const routeData = z
  .looseObject({
    success: z.boolean(),
    data: z
      .looseObject({
        routes: z.array(
          z.looseObject({
            name: z.string(),
            deployment: z
              .looseObject({ version_id: z.string() })
              .nullable()
              .optional(),
          }),
        ),
      })
      .optional(),
  })
  .parse(await routeResponse.json());
const route = routeData.data?.routes.find((item) => item.name === "pr-review");
if (!routeResponse.ok || !routeData.success || !route)
  throw new Error("Cannot verify configured Gateway route");
const routeList = z
  .looseObject({
    data: z.looseObject({
      routes: z.array(z.looseObject({ id: z.string(), name: z.string() })),
    }),
  })
  .parse(routeData);
const routeId = routeList.data.routes.find(
  (item) => item.name === "pr-review",
)!.id;
const routeVersion = z
  .looseObject({
    success: z.literal(true),
    result: z.looseObject({
      data: z.array(
        z.looseObject({
          type: z.string(),
          properties: z
            .looseObject({
              provider: z.string(),
              model: z.string(),
              retries: z.literal(0),
            })
            .optional(),
        }),
      ),
    }),
  })
  .parse(
    await fetch(
      `https://api.cloudflare.com/client/v4/accounts/${config.accountId}/ai-gateway/gateways/${config.gatewayId}/routes/${routeId}/versions/${route.deployment?.version_id}`,
      {
        headers: { Authorization: `Bearer ${config.token}` },
        signal: AbortSignal.timeout(15_000),
      },
    ).then((response) => response.json()),
  );
const routeModels = routeVersion.result.data
  .filter((item) => item.type === "model")
  .map((item) => item.properties!);
if (
  routeModels.length !== 2 ||
  routeModels.some((item) => item.provider !== "openrouter") ||
  JSON.stringify(routeModels.map((item) => item.model).toSorted()) !==
    JSON.stringify(
      [
        "google/gemma-4-26b-a4b-it:free",
        "google/gemma-4-26b-a4b-it-20260403",
      ].toSorted(),
    )
)
  throw new Error(
    "Route no longer matches the costed two-attempt model policy",
  );
const priceResponse = await fetch(
  "https://openrouter.ai/api/v1/models/google/gemma-4-26b-a4b-it/endpoints",
  { signal: AbortSignal.timeout(15_000) },
);
if (!priceResponse.ok) throw new Error("Cannot verify current model prices");
const prices = z
  .looseObject({
    data: z.looseObject({
      endpoints: z
        .array(
          z.looseObject({
            pricing: z.looseObject({
              prompt: z.string(),
              completion: z.string(),
              request: z.string().optional(),
            }),
          }),
        )
        .min(1),
    }),
  })
  .parse(await priceResponse.json());
if (
  prices.data.endpoints.some(({ pricing }) => {
    const input = Number(pricing.prompt) * 1_000_000_000;
    const output = Number(pricing.completion) * 1_000_000_000;
    return (
      !Number.isFinite(input) ||
      !Number.isFinite(output) ||
      input < 0 ||
      output < 0 ||
      input > modelSpendPolicy.inputNanodollarsPerToken ||
      output > modelSpendPolicy.outputNanodollarsPerToken ||
      (pricing.request !== undefined && Number(pricing.request) !== 0)
    );
  })
)
  throw new Error("Model pricing exceeds the campaign reservation policy");
const configuration = {
  ...liveBenchmarkPlan,
  limits,
  profile: qualityCheck ? "quality-check" : "ablation",
  thinking,
  structuralContext,
  costPolicy: modelSpendPolicy,
  campaignExposureBeforeUSD:
    spend.snapshot().exposureNanodollars / 1_000_000_000,
  routeModels,
  pricesVerifiedAt: new Date().toISOString(),
  cases: probe
    ? liveBenchmarkPlan.cases
        .slice(0, 1)
        .map((item) => ({ ...item, variants: ["receipts"] }))
    : qualityCheck
      ? liveBenchmarkPlan.cases.map((item) => ({
          ...item,
          variants: ["receipts"],
        }))
      : liveBenchmarkPlan.cases,
  variants: probe || qualityCheck ? ["receipts"] : liveBenchmarkPlan.variants,
  probe,
  routeDeployment: route.deployment?.version_id ?? null,
  tracePayloads: false,
  cacheBypassed: true,
  image: "holon-repository-executor-holonsandbox:worker",
  imageDigest,
  sourceDigests: Object.fromEntries(
    await Promise.all(
      [
        "src/review/review-agent.ts",
        "evaluation/live-fixtures.ts",
        "../../packages/model/src/reviewer.ts",
        "../../packages/application/src/evidence.ts",
        "../../packages/model/src/causal-verification.ts",
        "../../packages/model/src/gateway.ts",
        "../../packages/contracts/src/review-output.ts",
        "evaluation/live-benchmark.mts",
        "evaluation/review-core.live.ts",
        "evaluation/live-fixture-executor.mts",
        "evaluation/live-benchmark-policy.ts",
        "evaluation/live-benchmark-budget.ts",
        "evaluation/live-model-spend.ts",
        "evaluation/live-fixture-context.mts",
        "evaluation/live-final-validation.ts",
        "../repository-executor/src/structural-repository-inventory.ts",
        "../repository-executor/src/review-context.ts",
        "../../packages/repository-analysis/src/changed-head-declarations.ts",
        "../../packages/repository-analysis/src/repository-module.ts",
        "../../packages/repository-analysis/src/symbol-extractor.ts",
        "../../packages/repository-analysis/src/structural-analyzer.ts",
        "../../pnpm-lock.yaml",
      ].map(async (path) => {
        const contents = await readFile(path);
        const repositoryPath = relative(resolve("../.."), resolve(path));
        const destination = resolve(
          outputDirectory,
          "sources",
          repositoryPath + ".source",
        );
        await mkdir(resolve(destination, ".."), { recursive: true });
        await writeFile(destination, contents);
        return [path, createHash("sha256").update(contents).digest("hex")];
      }),
    ),
  ),
  oracles,
  preparation: [...preparedFixtures].map(([caseId, item]) => ({
    caseId,
    headSha: item.headSha,
    baseSha: item.baseSha,
    paths: item.inventory.inventory.files.map((file) => file.path),
    truncated: item.inventory.inventory.truncated,
    metrics: item.inventory.metrics,
  })),
  resumedFrom: resumePath ? resolve(resumePath) : null,
};
if (previous) {
  assertLiveBenchmarkResume(previous.configuration, configuration);
  for (const event of previous.modelEvents) {
    if (!budget.admit(event.inputBytes, event.maxOutputTokens))
      throw new Error("Previous attempt exhausted the benchmark budget");
    modelEvents.push(event);
  }
  results.push(...previous.results);
}
await writeFile(
  resolve(outputDirectory, "plan.json"),
  JSON.stringify(configuration, null, 2) + "\n",
);
let persisted = Promise.resolve();
const checkpoint = () => {
  persisted = persisted.then(async () => {
    const temporary = resolve(outputDirectory, "results.tmp");
    await writeFile(
      temporary,
      JSON.stringify(
        {
          configuration,
          budget: budget.snapshot(),
          campaignExposureUSD:
            spend.snapshot().exposureNanodollars / 1_000_000_000,
          modelEvents,
          results,
        },
        null,
        2,
      ) + "\n",
    );
    return rename(temporary, resolve(outputDirectory, "results.json"));
  });
  return persisted;
};

async function body(request: IncomingMessage): Promise<string> {
  let result = "";
  for await (const chunk of request) {
    result += String(chunk);
    if (Buffer.byteLength(result) > 200_000)
      throw new Error("Request too large");
  }
  return result;
}

let transportHalted = false;
const server = createServer((request, response) => {
  void (async () => {
    if (request.method !== "POST") {
      response.writeHead(405).end();
      return;
    }
    const text = await body(request);
    const raw: unknown = JSON.parse(text);
    const send = (value: unknown) => {
      response
        .writeHead(200, { "Content-Type": "application/json" })
        .end(JSON.stringify(value));
    };
    if (request.url === "/job") {
      const input = z
        .strictObject({
          caseId: z.enum(liveFixtures.map((item) => item.id)),
          variant: z.enum(liveVariants),
        })
        .parse(raw);
      const fixture = liveFixtures.find((item) => item.id === input.caseId)!;
      const number =
        fixture.prNumber * 10 + liveVariants.indexOf(input.variant) + 1;
      const prepared = preparedFixtures.get(fixture.id);
      const headSha =
        prepared?.headSha ??
        createHash("sha1").update(JSON.stringify(fixture.files)).digest("hex");
      const baseSha =
        prepared?.baseSha ??
        createHash("sha1")
          .update(
            JSON.stringify({
              ...fixture.files,
              "src/producer.ts": fixture.baseProducer,
            }),
          )
          .digest("hex");
      const runId = `github:4242:pr:${number}:head:${headSha}:base:${baseSha}`;
      if (runs.has(runId)) throw new Error("Repeated paid case");
      runs.set(runId, {
        executor: new LiveFixtureExecutor(
          resolve(fixtureRoot, fixture.id, "head"),
          fixture.files,
          imageDigest,
        ),
        variant: input.variant,
        caseId: fixture.id,
      });
      const timestamp = new Date().toISOString();
      send({
        runId,
        envelope: {
          action: "opened",
          event: "pull_request",
          deliveryId: `github:live-${number}`,
          installationId: 99,
          receivedAt: timestamp,
          pullRequest: { number, headSha, baseSha, updatedAt: timestamp },
          repository: {
            id: 4242,
            owner: "synthetic",
            name: "fixture",
            fullName: "synthetic/fixture",
          },
        },
        ...(prepared
          ? {
              context: buildReviewArtifacts(
                executorRequestSchema.parse({
                  runId,
                  headSha,
                  baseSha,
                  canonicalDiff: fixture.patch,
                  repositoryId: 4242,
                  pullRequestNumber: number,
                  repositoryOwner: "synthetic",
                  repositoryName: "fixture",
                  cloneUrl: "https://github.com/synthetic/fixture.git",
                  installationId: 99,
                  effectivePolicy: {
                    additionalExcludes: [],
                    baseSha,
                    effectivePolicyDigest: "a".repeat(64),
                    source: "default",
                    sourceDigest: null,
                    verdictStrictness: "default",
                  },
                }),
                prepared.inventory.inventory.files,
                prepared.inventory.inventory.truncated,
              ).context,
            }
          : {}),
      });
    } else if (request.url === "/model") {
      if (transportHalted) {
        response
          .writeHead(503)
          .end('{"error":{"message":"BENCHMARK_TRANSPORT_HALTED"}}');
        return;
      }
      const model = requestSchema.parse(raw);
      // Experiment at the external transport seam only; production settings stay unchanged.
      const provider = z
        .looseObject({ provider: z.record(z.string(), z.unknown()).optional() })
        .parse(model).provider;
      const upstreamBody = JSON.stringify({
        ...model,
        ...(thinking ? { reasoning: { enabled: true } } : {}),
        provider,
      });
      const inputBytes = Buffer.byteLength(upstreamBody);
      const spendId = `${outputDirectory.split("/").pop()}:${modelEvents.length}`;
      if (
        !budget.admit(inputBytes, model.max_tokens) ||
        !spend.reserve(spendId, inputBytes, model.max_tokens)
      ) {
        response.writeHead(429).end('{"error":{"message":"BENCHMARK_LIMIT"}}');
        return;
      }
      await persistSpend(); // Persist the worst-case reservation before any paid request.
      const event: (typeof modelEvents)[number] = {
        status: 0,
        inputBytes,
        maxOutputTokens: model.max_tokens,
        durationMs: 0,
        spendId,
        returnedTools: [],
        streamDone: false,
      };
      const metadataHeader = request.headers["cf-aig-metadata"];
      if (typeof metadataHeader === "string") {
        const metadata = z
          .strictObject({
            run_id: runIdSchema,
            shard_index: z.literal("0"),
            stage: z.enum(["investigation", "causal_verification"]),
          })
          .parse(JSON.parse(metadataHeader));
        if (!runs.has(metadata.run_id)) throw new Error("Unknown model run");
        event.phase = metadata.stage;
      }
      const transport = z
        .looseObject({
          tool_choice: z.unknown().optional(),
          tools: z
            .array(
              z.looseObject({ function: z.looseObject({ name: z.string() }) }),
            )
            .optional(),
        })
        .parse(raw);
      event.toolChoice = transport.tool_choice;
      event.toolNames =
        transport.tools?.map((item) => item.function.name) ?? [];
      modelEvents.push(event);
      const start = performance.now();
      try {
        const upstream = await fetch(
          `https://gateway.ai.cloudflare.com/v1/${config.accountId}/${config.gatewayId}/compat/chat/completions`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "cf-aig-authorization": `Bearer ${config.token}`,
              "cf-aig-skip-cache": "true",
              "cf-aig-collect-log-payload": "false",
            },
            body: upstreamBody,
            signal: AbortSignal.timeout(limits.requestMs),
          },
        );
        event.status = upstream.status;
        event.firstByteMs = performance.now() - start;
        if (!upstream.ok || !upstream.body) {
          transportHalted = true;
          const errorText = await upstream.text();
          event.providerErrorHints = [
            "No endpoints",
            "tool_choice",
            "parallel_tool_calls",
            "max_price",
            "allow_fallbacks",
            "parameters",
            "schema",
            "required",
            "provider",
          ].filter((hint) => errorText.includes(hint));
          response
            .writeHead(upstream.status)
            .end('{"error":{"message":"BENCHMARK_PROVIDER_FAILED"}}');
          return;
        }
        response.writeHead(200, { "Content-Type": "text/event-stream" });
        const reader = upstream.body.getReader();
        const decoder = new TextDecoder();
        let pending = "";
        const returnedArguments = new Map<
          number,
          { name: string; text: string }
        >();
        let receivedBytes = 0;
        for (;;) {
          const part = await reader.read();
          if (part.done) break;
          receivedBytes += part.value.byteLength;
          if (receivedBytes > 300_000) {
            await reader.cancel();
            throw new Error("Response too large");
          }
          response.write(part.value);
          pending += decoder.decode(part.value, { stream: true });
          const lines = pending.split("\n");
          pending = lines.pop()!;
          for (const line of lines) {
            if (line === "data: [DONE]") {
              event.streamDone = true;
              continue;
            }
            if (!line.startsWith("data: ")) continue;
            const chunk = z
              .looseObject({
                choices: z
                  .array(
                    z.looseObject({
                      finish_reason: z.string().nullable().optional(),
                      delta: z
                        .looseObject({
                          tool_calls: z
                            .array(
                              z.looseObject({
                                index: z.number().int().nonnegative(),
                                function: z
                                  .looseObject({
                                    name: z.string().optional(),
                                    arguments: z.string().optional(),
                                  })
                                  .optional(),
                              }),
                            )
                            .optional(),
                        })
                        .optional(),
                    }),
                  )
                  .optional(),
                model: z
                  .string()
                  .regex(/^[A-Za-z0-9/_.:-]{1,150}$/u)
                  .optional(),
                usage: z
                  .looseObject({
                    prompt_tokens: z.number().nonnegative().optional(),
                    completion_tokens: z.number().nonnegative().optional(),
                    completion_tokens_details: z
                      .looseObject({
                        reasoning_tokens: z.number().nonnegative().optional(),
                      })
                      .nullable()
                      .optional(),
                    cost: z.number().nonnegative().optional(),
                  })
                  .nullable()
                  .optional(),
              })
              .parse(JSON.parse(line.slice(6)));
            for (const choice of chunk.choices ?? []) {
              if (choice.finish_reason)
                event.finishReason = [
                  "stop",
                  "length",
                  "tool_calls",
                  "error",
                  "content_filter",
                ].includes(choice.finish_reason)
                  ? choice.finish_reason
                  : "other";
              for (const tool of choice.delta?.tool_calls ?? []) {
                const item = returnedArguments.get(tool.index) ?? {
                  name: "",
                  text: "",
                };
                item.name += tool.function?.name ?? "";
                item.text += tool.function?.arguments ?? "";
                returnedArguments.set(tool.index, item);
                if (tool.function?.name)
                  event.returnedTools!.push(
                    [
                      "read_file",
                      "search_text",
                      "search_structure",
                      "think_final_answer",
                    ].includes(tool.function.name)
                      ? tool.function.name
                      : "other",
                  );
              }
            }
            if (chunk.model) event.model = chunk.model;
            if (chunk.usage?.prompt_tokens !== undefined)
              event.inputTokens = chunk.usage.prompt_tokens;
            if (chunk.usage?.completion_tokens !== undefined)
              event.outputTokens = chunk.usage.completion_tokens;
            if (
              chunk.usage?.completion_tokens_details?.reasoning_tokens !==
              undefined
            )
              event.reasoningTokens =
                chunk.usage.completion_tokens_details.reasoning_tokens;
            if (chunk.usage?.cost !== undefined) event.cost = chunk.usage.cost;
          }
        }
        if (event.phase === "investigation") {
          const final = [...returnedArguments.values()].find(
            (item) => item.name === "think_final_answer",
          );
          if (final)
            event.finalValidation = finalValidationMetadata(final.text);
        }
        response.end();
      } finally {
        event.durationMs = performance.now() - start;
        if (event.streamDone && event.cost !== undefined)
          spend.settle(spendId, event.cost);
        await persistSpend();
        await checkpoint();
      }
    } else if (request.url === "/tool") {
      const input = z
        .strictObject({ runId: runIdSchema, call: z.unknown() })
        .parse(raw);
      const run = runs.get(input.runId);
      if (!run) throw new Error("Unknown fixture run");
      send(await run.executor.run(input.runId, input.call));
    } else if (request.url === "/evidence" || request.url === "/cleanup") {
      const { runId } = runSchema.parse(raw);
      const run = runs.get(runId);
      if (!run) throw new Error("Unknown fixture run");
      if (request.url === "/cleanup") {
        await run.executor.cleanup();
        send({ ok: true });
      } else send(run.executor.pack());
    } else if (request.url === "/result") {
      const result = resultSchema.parse(raw);
      const run = runs.get(result.runId);
      if (
        !run ||
        run.caseId !== result.caseId ||
        run.variant !== result.variant
      )
        throw new Error("Result identity mismatch");
      results.push({
        ...result,
        executor: run.executor.metrics(),
        modelEventEnd: modelEvents.length,
      });
      await checkpoint();
      console.log(
        JSON.stringify({
          caseId: result.caseId,
          variant: result.variant,
          passed: result.passed,
          failure: result.failure,
          durationMs: result.durationMs,
        }),
      );
      send({ ok: true });
    } else if (request.url === "/complete") {
      await checkpoint();
      send({ ok: true });
    } else response.writeHead(404).end();
  })().catch(() => {
    if (!response.headersSent) response.writeHead(502);
    response.end('{"error":{"message":"BENCHMARK_TRANSPORT_FAILED"}}');
  });
});
await new Promise<void>((done) => server.listen(0, "127.0.0.1", done));
const address = server.address();
if (!address || typeof address === "string")
  throw new Error("Missing benchmark listener");
const childEnv: NodeJS.ProcessEnv = {
  ...process.env,
  HOLON_LIVE_RELAY_URL: `http://127.0.0.1:${address.port}`,
  HOLON_LIVE_PROBE: String(probe),
  HOLON_LIVE_DONE: JSON.stringify(
    results.map((result) => {
      const parsed = resultSchema.parse(result);
      return `${parsed.caseId}:${parsed.variant}`;
    }),
  ),
  HOLON_LIVE_QUALITY_CHECK: String(qualityCheck),
};
for (const name of [
  "AI_GATEWAY_API_TOKEN",
  "CLOUDFLARE_API_TOKEN",
  "HOLON_BENCH_CREDENTIAL_FILE",
])
  delete childEnv[name];
const child = spawn(
  "pnpm",
  ["exec", "vitest", "run", "--config", "vitest.live.config.ts"],
  { stdio: "inherit", env: childEnv },
);
const timer = setTimeout(() => child.kill("SIGTERM"), limits.suiteMs);
try {
  const code = await new Promise<number | null>((done) =>
    child.on("exit", done),
  );
  await checkpoint();
  console.log(
    JSON.stringify({
      outputDirectory,
      budget: budget.snapshot(),
      results: results.length,
      harnessExitCode: code,
      campaignExposureUSD: spend.snapshot().exposureNanodollars / 1_000_000_000,
    }),
  );
  process.exitCode = liveBenchmarkExitCode(
    code,
    results.map((result) => {
      const parsed = resultSchema.parse(result);
      return {
        key: `${parsed.caseId}:${parsed.variant}`,
        passed: parsed.passed,
      };
    }),
    configuration.cases.flatMap((item) =>
      item.variants.map((variant) => `${item.id}:${variant}`),
    ),
  );
} finally {
  clearTimeout(timer);
  await Promise.allSettled(
    [...runs.values()].map((run) => run.executor.cleanup()),
  );
  await new Promise<void>((done) => server.close(() => done()));
  await rm(fixtureRoot, { recursive: true, force: true });
  await spendLock.close();
}
