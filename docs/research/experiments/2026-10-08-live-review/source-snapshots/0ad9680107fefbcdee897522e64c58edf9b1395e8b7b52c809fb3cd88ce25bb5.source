import { spawn } from "node:child_process";
import { createHash } from "node:crypto";
import {
  mkdir,
  mkdtemp,
  readFile,
  rename,
  rm,
  writeFile,
} from "node:fs/promises";
import { createServer, type IncomingMessage } from "node:http";
import { tmpdir } from "node:os";
import { relative, resolve } from "node:path";
import { parseEnv } from "node:util";

import { runIdSchema, executorRequestSchema } from "@holon/contracts";
import { z } from "zod";

import { buildReviewArtifacts } from "../../repository-executor/src/review-context.js";
import { LiveBenchmarkBudget } from "./live-benchmark-budget.js";
import {
  assertLiveBenchmarkResume,
  liveBenchmarkExitCode,
} from "./live-benchmark-policy.js";
import { openModelCampaign } from "./live-campaign-spend.mjs";
import { liveCodeRegressionFixtures } from "./live-code-regression-fixtures.js";
import { liveConfirmationFixtures } from "./live-confirmation-fixtures.js";
import {
  commitFixture,
  prepareFixtureInventory,
} from "./live-fixture-context.mjs";
import {
  LiveFixtureExecutor,
  validateFixtureOracle,
  fixtureImageDigest,
} from "./live-fixture-executor.mjs";
import { validateFixtureTypecheck } from "./live-fixture-typecheck.mjs";
import {
  liveBenchmarkPlan,
  liveFixtures as developmentFixtures,
  liveCaseVariants,
  liveVariants,
} from "./live-fixtures.js";
import { verifyBenchmarkRoute } from "./live-gateway-route.mjs";
import { liveHoldoutFixtures } from "./live-holdout-fixtures.js";
import {
  LiveModelRelay,
  liveModelEventSchema as eventSchema,
} from "./live-model-relay.mjs";
import { modelSpendPolicy } from "./live-model-spend.js";

async function body(request: IncomingMessage): Promise<string> {
  let result = "";
  for await (const chunk of request) {
    result += String(chunk);
    if (Buffer.byteLength(result) > 200_000)
      throw new Error("Request too large");
  }
  return result;
}

const credentialFile = process.env.HOLON_BENCH_CREDENTIAL_FILE;
if (!credentialFile)
  throw new Error(
    "Set HOLON_BENCH_CREDENTIAL_FILE to an authorized local credential file",
  );
const variables = parseEnv(await readFile(credentialFile, "utf8"));
const config = z
  .strictObject({
    accountId: z.string().regex(/^[a-f0-9]{32}$/u),
    gatewayId: z.string().regex(/^[A-Za-z0-9_-]{1,64}$/u),
    token: z.string().min(1),
  })
  .parse({
    accountId:
      process.env.AI_GATEWAY_ACCOUNT_ID ?? variables.AI_GATEWAY_ACCOUNT_ID,
    gatewayId: process.env.AI_GATEWAY_ID ?? variables.AI_GATEWAY_ID,
    token: variables.AI_GATEWAY_API_TOKEN ?? variables.CLOUDFLARE_API_TOKEN,
  });
const probe = process.argv.includes("--probe");
const qualityCheck = process.argv.includes("--quality-check");
const thinking = process.argv.includes("--thinking");
const holdout = process.argv.includes("--holdout");
const confirmation = process.argv.includes("--confirmation");
const codeRegression = process.argv.includes("--code-regression");
if (Number(confirmation) + Number(holdout) + Number(codeRegression) > 1)
  throw new Error("Select only one benchmark partition");
if (confirmation && (!qualityCheck || holdout))
  throw new Error(
    "Confirmation requires quality-check and a separate partition",
  );
const partition = codeRegression
  ? "code-regression"
  : confirmation
    ? "confirmation"
    : holdout
      ? "holdout"
      : "development";
if (holdout && !qualityCheck)
  throw new Error("Holdout requires the bounded quality-check profile");
if (
  codeRegression &&
  (!qualityCheck || !process.argv.includes("--structural-context"))
)
  throw new Error(
    "Code regressions require quality-check and structural-context",
  );
const liveFixtures = codeRegression
  ? liveCodeRegressionFixtures
  : confirmation
    ? liveConfirmationFixtures
    : holdout
      ? liveHoldoutFixtures
      : developmentFixtures;
const structuralContext = process.argv.includes("--structural-context");
const temperature = process.argv.includes("--temperature-zero") ? 0 : null;
if (temperature !== null && !qualityCheck)
  throw new Error("Temperature experiment requires quality-check");
if (thinking && !qualityCheck)
  throw new Error(
    "Thinking experiment requires the bounded quality-check profile",
  );
const limits = codeRegression
  ? {
      calls: 14,
      inputBytes: 250_000,
      outputTokens: 30_000,
      requestMs: 45_000,
      suiteMs: 4 * 60_000,
    }
  : qualityCheck
    ? {
        calls: 24,
        inputBytes: 600_000,
        outputTokens: 50_000,
        requestMs: 45_000,
        suiteMs: 6 * 60_000,
      }
    : liveBenchmarkPlan.limits;
const outputDirectory = resolve(
  "../../artifacts/evaluation",
  `live-${new Date().toISOString().replaceAll(":", "-")}${probe ? "-probe" : ""}`,
);
await mkdir(outputDirectory, { recursive: true });
const spendPath = resolve("../../artifacts/evaluation/live-spend.json");
await using campaign = await openModelCampaign(
  spendPath,
  resolve(
    "../../docs/research/experiments/2026-10-08-live-review/campaign-spend.json",
  ),
);
const { spend, persistSpend } = campaign;
const fixtureRoot = await mkdtemp(resolve(tmpdir(), "holon-live-fixtures-"));
try {
  const budget = new LiveBenchmarkBudget(limits);
  const resultSchema = z.looseObject({
    caseId: z.enum(liveFixtures.map((item) => item.id)),
    variant: z.enum(liveVariants),
    runId: runIdSchema,
    passed: z.boolean(),
    expectedDefect: z.boolean(),
    failure: z.string().nullable(),
    durationMs: z.number().nonnegative(),
  });
  const runSchema = z.strictObject({ runId: runIdSchema });
  const runs = new Map<
    string,
    { executor: LiveFixtureExecutor; variant: string; caseId: string }
  >();
  const results: unknown[] = [];
  const modelEvents: Array<z.infer<typeof eventSchema>> = [];
  const resumePath = process.env.HOLON_BENCH_RESUME_RESULTS;
  const previous = resumePath
    ? z
        .looseObject({
          configuration: z.looseObject({
            profile: z.enum(["quality-check", "ablation"]),
            structuralContext: z.boolean(),
            partition: z.enum([
              "development",
              "holdout",
              "confirmation",
              "code-regression",
            ]),
            thinking: z.boolean(),
            temperature: z.number().nullable(),
            costPolicy: z.record(z.string(), z.number()),
            probe: z.boolean(),
            limits: z.record(z.string(), z.number()),
            cases: z.array(z.unknown()),
            variants: z.array(z.string()),
            sourceDigests: z.record(z.string(), z.string()),
            routeDeployment: z.string().nullable(),
            imageDigest: z.string(),
          }),
          results: z.array(resultSchema),
          modelEvents: z.array(eventSchema),
        })
        .parse(JSON.parse(await readFile(resumePath, "utf8")))
    : null;
  const oracles = [];
  const imageDigest = await fixtureImageDigest();
  const preparedFixtures = new Map<
    string,
    {
      headSha: string;
      baseSha: string;
      inventory: Awaited<ReturnType<typeof prepareFixtureInventory>>;
    }
  >();
  for (const fixture of liveFixtures) {
    const head = resolve(fixtureRoot, fixture.id, "head");
    const base = resolve(fixtureRoot, fixture.id, "base");
    for (const [directory, files] of [
      [head, fixture.files],
      [base, { ...fixture.files, "src/producer.ts": fixture.baseProducer }],
    ] as const) {
      await mkdir(resolve(directory, "src"), { recursive: true });
      await Promise.all(
        Object.entries(files).map(([path, content]) =>
          writeFile(resolve(directory, path), content),
        ),
      );
    }
    oracles.push({
      caseId: fixture.id,
      baseTypecheck: await validateFixtureTypecheck(base),
      headTypecheck: await validateFixtureTypecheck(head),
      base: await validateFixtureOracle(base, false),
      head: await validateFixtureOracle(head, fixture.positive),
    });
    if (structuralContext)
      preparedFixtures.set(fixture.id, {
        headSha: await commitFixture(head),
        baseSha: await commitFixture(base),
        inventory: await prepareFixtureInventory(
          head,
          fixture.files,
          fixture.patch,
          imageDigest,
        ),
      });
  }

  const verifiedRoute = await verifyBenchmarkRoute(config);
  const fixtureCases = liveFixtures.map(({ id, family, positive }) => ({
    id,
    family,
    positive,
    variants: liveCaseVariants(family),
  }));
  const configuration = {
    ...liveBenchmarkPlan,
    limits,
    profile: qualityCheck ? "quality-check" : "ablation",
    thinking,
    temperature,
    structuralContext,
    partition,
    costPolicy: modelSpendPolicy,
    campaignExposureBeforeUSD:
      spend.snapshot().exposureNanodollars / 1_000_000_000,
    ...verifiedRoute,
    cases: probe
      ? fixtureCases
          .slice(0, 1)
          .map((item) => ({ ...item, variants: ["receipts"] }))
      : qualityCheck
        ? fixtureCases.map((item) => ({
            ...item,
            variants: ["receipts"],
          }))
        : fixtureCases,
    variants: probe || qualityCheck ? ["receipts"] : liveBenchmarkPlan.variants,
    probe,
    tracePayloads: false,
    cacheBypassed: true,
    image: "holon-repository-executor-holonsandbox:worker",
    imageDigest,
    sourceDigests: Object.fromEntries(
      await Promise.all(
        [
          "src/review/review-agent.ts",
          "evaluation/live-fixtures.ts",
          "../../packages/model/src/reviewer.ts",
          "../../packages/application/src/evidence.ts",
          "../../packages/model/src/causal-verification.ts",
          "../../packages/model/src/gateway.ts",
          "../../packages/contracts/src/review-output.ts",
          "../../packages/contracts/src/causal-verification.ts",
          "evaluation/live-benchmark.mts",
          "evaluation/review-core.live.ts",
          "evaluation/live-fixture-executor.mts",
          "evaluation/live-benchmark-policy.ts",
          "evaluation/live-benchmark-budget.ts",
          "evaluation/live-model-spend.ts",
          "evaluation/live-fixture-context.mts",
          "evaluation/live-holdout-fixtures.ts",
          "evaluation/live-confirmation-fixtures.ts",
          "evaluation/live-code-regression-fixtures.ts",
          "evaluation/live-gateway-route.mts",
          "evaluation/live-model-relay.mts",
          "evaluation/live-campaign-spend.mts",
          "evaluation/live-final-validation.ts",
          "evaluation/live-review-grade.ts",
          "evaluation/live-fixture-typecheck.mts",
          "../repository-executor/src/structural-repository-inventory.ts",
          "../repository-executor/src/review-context.ts",
          "../../packages/repository-analysis/src/changed-head-declarations.ts",
          "../../packages/repository-analysis/src/repository-module.ts",
          "../../packages/repository-analysis/src/symbol-extractor.ts",
          "../../packages/repository-analysis/src/structural-analyzer.ts",
          "../../pnpm-lock.yaml",
        ].map(async (path) => {
          const contents = await readFile(path);
          const repositoryPath = relative(resolve("../.."), resolve(path));
          const destination = resolve(
            outputDirectory,
            "sources",
            repositoryPath + ".source",
          );
          await mkdir(resolve(destination, ".."), { recursive: true });
          await writeFile(destination, contents);
          return [path, createHash("sha256").update(contents).digest("hex")];
        }),
      ),
    ),
    oracles,
    preparation: [...preparedFixtures].map(([caseId, item]) => ({
      caseId,
      headSha: item.headSha,
      baseSha: item.baseSha,
      paths: item.inventory.inventory.files.map((file) => file.path),
      truncated: item.inventory.inventory.truncated,
      metrics: item.inventory.metrics,
    })),
    resumedFrom: resumePath ? resolve(resumePath) : null,
  };
  if (previous) {
    assertLiveBenchmarkResume(previous.configuration, configuration);
    for (const event of previous.modelEvents) {
      if (!budget.admit(event.inputBytes, event.maxOutputTokens))
        throw new Error("Previous attempt exhausted the benchmark budget");
      modelEvents.push(event);
    }
    results.push(...previous.results);
  }
  await writeFile(
    resolve(outputDirectory, "plan.json"),
    JSON.stringify(configuration, null, 2) + "\n",
  );
  let persisted = Promise.resolve();
  const checkpoint = () => {
    persisted = persisted.then(async () => {
      const temporary = resolve(outputDirectory, "results.tmp");
      await writeFile(
        temporary,
        JSON.stringify(
          {
            configuration,
            budget: budget.snapshot(),
            campaignExposureUSD:
              spend.snapshot().exposureNanodollars / 1_000_000_000,
            modelEvents,
            results,
          },
          null,
          2,
        ) + "\n",
      );
      return rename(temporary, resolve(outputDirectory, "results.json"));
    });
    return persisted;
  };

  const modelRelay = new LiveModelRelay({
    gateway: config,
    budget,
    spend,
    events: modelEvents,
    cohortId: outputDirectory.split("/").pop()!,
    thinking,
    temperature,
    requestMs: limits.requestMs,
    knownRun: (runId) => runs.has(runId),
    persistSpend,
    checkpoint,
  });
  const server = createServer((request, response) => {
    void (async () => {
      if (request.method !== "POST") {
        response.writeHead(405).end();
        return;
      }
      const text = await body(request);
      const raw: unknown = JSON.parse(text);
      const send = (value: unknown) => {
        response
          .writeHead(200, { "Content-Type": "application/json" })
          .end(JSON.stringify(value));
      };
      if (request.url === "/job") {
        const input = z
          .strictObject({
            caseId: z.enum(liveFixtures.map((item) => item.id)),
            variant: z.enum(liveVariants),
          })
          .parse(raw);
        const fixture = liveFixtures.find((item) => item.id === input.caseId)!;
        const number =
          fixture.prNumber * 10 + liveVariants.indexOf(input.variant) + 1;
        const prepared = preparedFixtures.get(fixture.id);
        const headSha =
          prepared?.headSha ??
          createHash("sha1")
            .update(JSON.stringify(fixture.files))
            .digest("hex");
        const baseSha =
          prepared?.baseSha ??
          createHash("sha1")
            .update(
              JSON.stringify({
                ...fixture.files,
                "src/producer.ts": fixture.baseProducer,
              }),
            )
            .digest("hex");
        const runId = `github:4242:pr:${number}:head:${headSha}:base:${baseSha}`;
        if (runs.has(runId)) throw new Error("Repeated paid case");
        runs.set(runId, {
          executor: new LiveFixtureExecutor(
            resolve(fixtureRoot, fixture.id, "head"),
            fixture.files,
            imageDigest,
          ),
          variant: input.variant,
          caseId: fixture.id,
        });
        const timestamp = new Date().toISOString();
        send({
          runId,
          envelope: {
            action: "opened",
            event: "pull_request",
            deliveryId: `github:live-${number}`,
            installationId: 99,
            receivedAt: timestamp,
            pullRequest: { number, headSha, baseSha, updatedAt: timestamp },
            repository: {
              id: 4242,
              owner: "synthetic",
              name: "fixture",
              fullName: "synthetic/fixture",
            },
          },
          ...(prepared
            ? {
                context: buildReviewArtifacts(
                  executorRequestSchema.parse({
                    runId,
                    headSha,
                    baseSha,
                    canonicalDiff: fixture.patch,
                    repositoryId: 4242,
                    pullRequestNumber: number,
                    repositoryOwner: "synthetic",
                    repositoryName: "fixture",
                    cloneUrl: "https://github.com/synthetic/fixture.git",
                    installationId: 99,
                    effectivePolicy: {
                      additionalExcludes: [],
                      baseSha,
                      effectivePolicyDigest: "a".repeat(64),
                      source: "default",
                      sourceDigest: null,
                      verdictStrictness: "default",
                    },
                  }),
                  prepared.inventory.inventory.files,
                  prepared.inventory.inventory.truncated,
                ).context,
              }
            : {}),
        });
      } else if (request.url === "/model") {
        await modelRelay.respond(request, raw, response);
      } else if (request.url === "/tool") {
        const input = z
          .strictObject({ runId: runIdSchema, call: z.unknown() })
          .parse(raw);
        const run = runs.get(input.runId);
        if (!run) throw new Error("Unknown fixture run");
        send(await run.executor.run(input.runId, input.call));
      } else if (request.url === "/evidence" || request.url === "/cleanup") {
        const { runId } = runSchema.parse(raw);
        const run = runs.get(runId);
        if (!run) throw new Error("Unknown fixture run");
        if (request.url === "/cleanup") {
          await run.executor.cleanup();
          send({ ok: true });
        } else send(run.executor.pack());
      } else if (request.url === "/result") {
        const result = resultSchema.parse(raw);
        const run = runs.get(result.runId);
        if (
          !run ||
          run.caseId !== result.caseId ||
          run.variant !== result.variant
        )
          throw new Error("Result identity mismatch");
        results.push({
          ...result,
          executor: run.executor.metrics(),
          modelEventEnd: modelEvents.length,
        });
        await checkpoint();
        console.log(
          JSON.stringify({
            caseId: result.caseId,
            variant: result.variant,
            passed: result.passed,
            failure: result.failure,
            durationMs: result.durationMs,
          }),
        );
        send({ ok: true });
      } else if (request.url === "/complete") {
        await checkpoint();
        send({ ok: true });
      } else response.writeHead(404).end();
    })().catch(() => {
      if (!response.headersSent) response.writeHead(502);
      response.end('{"error":{"message":"BENCHMARK_TRANSPORT_FAILED"}}');
    });
  });
  await new Promise<void>((done) => server.listen(0, "127.0.0.1", done));
  const address = server.address();
  if (!address || typeof address === "string")
    throw new Error("Missing benchmark listener");
  const childEnv: NodeJS.ProcessEnv = {
    ...process.env,
    HOLON_LIVE_RELAY_URL: `http://127.0.0.1:${address.port}`,
    HOLON_LIVE_PROBE: String(probe),
    HOLON_LIVE_DONE: JSON.stringify(
      results.map((result) => {
        const parsed = resultSchema.parse(result);
        return `${parsed.caseId}:${parsed.variant}`;
      }),
    ),
    HOLON_LIVE_QUALITY_CHECK: String(qualityCheck),
    HOLON_LIVE_PARTITION: partition,
  };
  for (const name of [
    "AI_GATEWAY_API_TOKEN",
    "CLOUDFLARE_API_TOKEN",
    "HOLON_BENCH_CREDENTIAL_FILE",
  ])
    delete childEnv[name];
  const child = spawn(
    "pnpm",
    ["exec", "vitest", "run", "--config", "vitest.live.config.ts"],
    { stdio: "inherit", env: childEnv },
  );
  const timer = setTimeout(() => child.kill("SIGTERM"), limits.suiteMs);
  try {
    const code = await new Promise<number | null>((done, reject) => {
      child.once("exit", done);
      child.once("error", reject);
    });
    await checkpoint();
    console.log(
      JSON.stringify({
        outputDirectory,
        budget: budget.snapshot(),
        results: results.length,
        harnessExitCode: code,
        campaignExposureUSD:
          spend.snapshot().exposureNanodollars / 1_000_000_000,
      }),
    );
    process.exitCode = liveBenchmarkExitCode(
      code,
      results.map((result) => {
        const parsed = resultSchema.parse(result);
        return {
          key: `${parsed.caseId}:${parsed.variant}`,
          passed: parsed.passed,
        };
      }),
      configuration.cases.flatMap((item) =>
        item.variants.map((variant) => `${item.id}:${variant}`),
      ),
    );
  } finally {
    clearTimeout(timer);
    await Promise.allSettled(
      [...runs.values()].map((run) => run.executor.cleanup()),
    );
    await new Promise<void>((done) => server.close(() => done()));
  }
} finally {
  await rm(fixtureRoot, { recursive: true, force: true });
}
