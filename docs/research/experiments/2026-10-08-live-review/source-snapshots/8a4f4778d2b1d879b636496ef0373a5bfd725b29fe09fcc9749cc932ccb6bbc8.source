import { unlinkSync } from "node:fs";
import { open, readFile, rename, writeFile } from "node:fs/promises";

import { z } from "zod";

import { LiveModelSpend, modelSpendPolicy } from "./live-model-spend.js";

/** Own the process lock and atomic campaign checkpoint; a new run never renews money. */
export async function openModelCampaign(spendPath: string, seedPath: string) {
  const lockPath = spendPath + ".lock";
  const lock = await open(lockPath, "wx");
  const releaseLock = () => unlinkSync(lockPath);
  process.once("exit", releaseLock);
  try {
    const spendRecordSchema = z.strictObject({
      id: z.string().min(1),
      reservedNanodollars: z.number().int().positive(),
      chargedNanodollars: z.number().int().nonnegative().optional(),
    });
    const savedSpendSchema = z.strictObject({
      policy: z.record(z.string(), z.number()),
      records: z.array(spendRecordSchema),
      exposureNanodollars: z.number().int().nonnegative(),
    });
    let spend: LiveModelSpend;
    try {
      const saved = savedSpendSchema.parse(
        JSON.parse(await readFile(spendPath, "utf8")),
      );
      if (JSON.stringify(saved.policy) !== JSON.stringify(modelSpendPolicy))
        throw new Error("Campaign price policy changed");
      spend = new LiveModelSpend(saved.records);
      if (spend.snapshot().exposureNanodollars !== saved.exposureNanodollars)
        throw new Error("Campaign spending totals disagree");
    } catch (error) {
      if (
        !(error instanceof Error) ||
        !("code" in error) ||
        error.code !== "ENOENT"
      )
        throw error;
      const archived = savedSpendSchema.parse(
        JSON.parse(await readFile(seedPath, "utf8")),
      );
      if (JSON.stringify(archived.policy) !== JSON.stringify(modelSpendPolicy))
        throw new Error("Archived campaign price policy changed");
      spend = new LiveModelSpend(archived.records);
      if (spend.snapshot().exposureNanodollars !== archived.exposureNanodollars)
        throw new Error("Archived campaign totals disagree");
    }
    let spendWrites = Promise.resolve();
    const persistSpend = () => {
      spendWrites = spendWrites.then(async () => {
        await writeFile(
          spendPath + ".tmp",
          JSON.stringify(spend.snapshot(), null, 2) + "\n",
        );
        await rename(spendPath + ".tmp", spendPath);
      });
      return spendWrites;
    };
    await persistSpend();
    return {
      spend,
      persistSpend,
      async [Symbol.asyncDispose]() {
        try {
          await spendWrites;
        } finally {
          await lock.close();
          process.removeListener("exit", releaseLock);
          unlinkSync(lockPath);
        }
      },
    };
  } catch (error) {
    await lock.close();
    process.removeListener("exit", releaseLock);
    unlinkSync(lockPath);
    throw error;
  }
}
