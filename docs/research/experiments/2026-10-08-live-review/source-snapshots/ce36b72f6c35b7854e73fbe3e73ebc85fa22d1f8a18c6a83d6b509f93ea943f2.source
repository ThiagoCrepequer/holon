import { z } from "zod";

import { reviewTextLimits } from "./review-limits.js";

/** A verifier may assess existing candidates, never emit or rewrite findings. */
export const causalVerificationSchema = z.strictObject({
  assessments: z
    .array(
      z
        .strictObject({
          candidateIndex: z
            .number()
            .int()
            .nonnegative()
            .max(reviewTextLimits.findings - 1),
          basis: z.enum(["patch", "repository"]),
          evidenceReferences: z
            .array(
              z
                .strictObject({
                  id: z
                    .string()
                    .regex(/^[a-f0-9]{64}$/u)
                    .describe(
                      "Copy the complete host-issued receipt id exactly; never invent or shorten it.",
                    ),
                  path: z.string().min(1).max(500),
                  startLine: z
                    .number()
                    .int()
                    .positive()
                    .describe(
                      "A line within the inspected receipt window, not the candidate patch coordinates.",
                    ),
                  endLine: z
                    .number()
                    .int()
                    .positive()
                    .describe(
                      "An inspected line at or after startLine, within the SAME receipt.",
                    ),
                })
                .refine(
                  (reference) => reference.endLine >= reference.startLine,
                  "Invalid inspected reference window",
                ),
            )
            .max(8),
          outcome: z.enum(["confirmed", "refuted", "inconclusive"]),
          confidence: z.number().min(0).max(1),
          rationale: z.string().trim().min(30).max(reviewTextLimits.diagnostic),
        })
        .refine(
          (value) =>
            value.basis === "patch"
              ? value.evidenceReferences.length === 0
              : value.evidenceReferences.length > 0,
          "Repository premises require inspected evidence references",
        ),
    )
    .max(reviewTextLimits.findings),
  summary: z.string().trim().min(1).max(reviewTextLimits.summary),
});

export type CausalVerification = z.infer<typeof causalVerificationSchema>;
