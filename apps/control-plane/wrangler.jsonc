{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROJECT_IDENTIFICATION_MODE": "observe",
    "PROJECT_IDENTIFICATION_PROFILE": "identification-v1",
    "AGENT_TRACE_PAYLOADS": "enabled",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_IDENTIFICATION_REGISTRY",
        "class_name": "ProjectIdentificationRegistryObject",
      },
      {
        "name": "PROJECT_IDENTIFICATION_CACHE",
        "class_name": "ProjectIdentificationCacheObject",
      },
      {
        "name": "REVIEW_LEDGERS",
        "class_name": "ReviewLedgerObject",
      },
      {
        "name": "REVIEW_AGENTS",
        "class_name": "ReviewAgent",
      },
      {
        "name": "FINDING_CLARIFICATION_AGENTS",
        "class_name": "FindingClarificationAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReviewLedgerObject"],
    },
    {
      "tag": "project-identification-v1",
      "new_sqlite_classes": [
        "ProjectIdentificationCacheObject",
        "ProjectIdentificationRegistryObject",
      ],
    },
    {
      "tag": "review-agent-v1",
      "new_sqlite_classes": ["ReviewAgent"],
    },
    {
      "tag": "finding-clarification-agent",
      "new_sqlite_classes": ["FindingClarificationAgent"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "holon-review-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "holon-review-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "holon-review-jobs-dlq",
      },
    ],
  },
  "workflows": [
    {
      "name": "holon-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow",
    },
    {
      "name": "holon-review-shard-workflow",
      "binding": "REVIEW_SHARD_WORKFLOW",
      "class_name": "ReviewShardWorkflow",
    },
    {
      "name": "holon-finding-clarification-workflow",
      "binding": "FINDING_CLARIFICATION_WORKFLOW",
      "class_name": "FindingClarificationWorkflow",
    },
  ],
  "services": [
    {
      "binding": "REPOSITORY_EXECUTOR",
      "service": "holon-repository-executor",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
}
