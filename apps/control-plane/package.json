{
  "name": "@holon/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "wrangler types --check && tsc --noEmit -p tsconfig.json",
    "test:local-review": "pnpm --filter @holon/evaluation exec tsx ../../apps/control-plane/local-review/run.ts"
  },
  "dependencies": {
    "@holon/application": "workspace:*",
    "@holon/contracts": "workspace:*",
    "@holon/domain": "workspace:*",
    "@holon/github": "workspace:*",
    "@holon/model": "workspace:*",
    "@holon/project-identification": "workspace:*",
    "@holon/repository-analysis": "workspace:*",
    "@holon/repository-config": "workspace:*",
    "fflate": "0.8.3",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
