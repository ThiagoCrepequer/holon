{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-repository-executor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "HolonSandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOXES",
        "class_name": "HolonSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HolonSandbox"],
    },
  ],
  "services": [
    {
      "binding": "GITHUB_CREDENTIAL_BROKER",
      "service": "holon-control-plane",
      "entrypoint": "GitHubCredentialBrokerEntrypoint",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "preview": {
      "durable_objects": {
        "bindings": [
          {
            "name": "SANDBOXES",
            "class_name": "HolonSandbox",
          },
        ],
      },
      "services": [
        {
          "binding": "GITHUB_CREDENTIAL_BROKER",
          "service": "holon-control-plane-preview",
          "entrypoint": "GitHubCredentialBrokerEntrypoint",
        },
      ],
      "containers": [
        {
          "class_name": "HolonSandbox",
          "image": "./Dockerfile",
          "instance_type": "lite",
          "max_instances": 10,
        },
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
        },
      },
      "name": "holon-repository-executor-preview",
      "workers_dev": false,
      "preview_urls": false,
    },
  },
  "preview_urls": false,
  "workers_dev": false,
}
