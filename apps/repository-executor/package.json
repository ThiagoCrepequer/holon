{
  "name": "@holon/repository-executor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node ../../tooling/deploy/blocked.mjs",
    "deploy:bootstrap": "node ../../tooling/deploy/blocked.mjs",
    "dev": "wrangler dev",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "wrangler types --check && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/sandbox": "catalog:",
    "@holon/application": "workspace:*",
    "@holon/contracts": "workspace:*",
    "@holon/domain": "workspace:*",
    "@holon/project-identification": "workspace:*",
    "@holon/repository-analysis": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
