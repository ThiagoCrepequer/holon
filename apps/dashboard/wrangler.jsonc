{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-dashboard-local",
  "main": "workers/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8794",
  },
  "services": [
    {
      "binding": "REVIEW_CORE",
      "service": "holon-control-plane",
      "entrypoint": "DashboardReviewReader",
    },
    { "binding": "EMAIL_DELIVERY", "service": "holon-email-delivery-local" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": false,
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "holon-identity-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "remote": false,
      "migrations_dir": "../../packages/db/migrations/identity",
    },
    {
      "binding": "PROJECTION_DB",
      "database_name": "holon-projection-local",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "remote": false,
      "migrations_dir": "../../packages/db/migrations/projection",
    },
  ],
  "env": {
    "production": {
      "name": "holon-dashboard",
      "services": [
        {
          "binding": "REVIEW_CORE",
          "service": "holon-control-plane",
          "entrypoint": "DashboardReviewReader",
        },
        { "binding": "EMAIL_DELIVERY", "service": "holon-email-delivery" },
      ],
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
        },
      },
      "vars": {
        "APP_ORIGIN": "https://holon-dashboard.thiago-crepequer.workers.dev",
        "AUTH_ENVIRONMENT": "production",
        "AUTH_REGISTERED_ORIGINS": "{\"preview\":[],\"production\":[\"https://holon-dashboard.thiago-crepequer.workers.dev\"]}",
        "AUTH_ENABLED": "true",
      },
      "d1_databases": [
        {
          "binding": "IDENTITY_DB",
          "database_name": "holon-identity",
          "database_id": "52a95f05-168f-4702-a064-10934931d3c8",
          "migrations_dir": "../../packages/db/migrations/identity",
        },
        {
          "binding": "PROJECTION_DB",
          "database_name": "holon-projection",
          "database_id": "af121530-2f99-4d01-8155-c20efc040a3b",
          "migrations_dir": "../../packages/db/migrations/projection",
        },
      ],
    },
  },
}
