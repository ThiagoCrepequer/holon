{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/brand/tokens/**",
        "$TURBO_ROOT$/docs/brand/assets/fonts/**"
      ],
      "outputs": ["build/**", "app/locales/*/messages.ts"]
    },
    "typecheck": {
      "outputs": [".react-router/**", "app/locales/*/messages.ts"]
    },
    "test": {
      "cache": false,
      "outputs": ["proof-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/brand/tokens/**",
        "$TURBO_ROOT$/docs/brand/assets/fonts/**"
      ]
    },
    "test:coverage": {
      "cache": false,
      "outputs": ["coverage/**", "proof-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/brand/tokens/**",
        "$TURBO_ROOT$/docs/brand/assets/fonts/**"
      ]
    }
  }
}
