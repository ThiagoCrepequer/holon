{
  "extends": "../../tooling/typescript/base.json",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "workers/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "*.ts",
    ".react-router/types/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@holon/ui": ["../../packages/ui/src"]
    }
  }
}
