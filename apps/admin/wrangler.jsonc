{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-admin",
  "main": "workers/app.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holon-admin-d1",
      "database_id": "df9bbb0e-6443-4cdd-87b8-d64a4ce2606a",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "holon-admin-projections",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "holon-admin-projections-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "services": [
    {
      "binding": "ADMIN_READ_API",
      "service": "holon-control-plane",
      "entrypoint": "AdminReadEntrypoint",
    },
  ],
  "routes": [
    {
      "pattern": "admin-holon.crepequer.dev",
      "custom_domain": true,
    },
  ],
}
