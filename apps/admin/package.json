{
  "name": "@holon/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "d1:migrate:local": "wrangler d1 migrations apply holon-admin-d1 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply holon-admin-d1 --remote",
    "d1:seed:local": "wrangler d1 execute holon-admin-d1 --local --file=scripts/seed-local.sql",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "preview": "vite build && vite preview",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.client.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.client.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@holon/contracts": "workspace:*",
    "@holon/observability": "workspace:*",
    "@holon/ui": "workspace:*",
    "@react-router/cloudflare": "catalog:",
    "jose": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
