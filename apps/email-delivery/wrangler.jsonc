{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-email-delivery-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
  },
  "env": {
    "production": {
      "name": "holon-email-delivery",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
        },
      },
    },
  },
}
