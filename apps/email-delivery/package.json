{
  "name": "@holon/email-delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "test:coverage": "pnpm build && vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@holon/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
