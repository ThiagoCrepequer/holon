{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holon-harness-evaluation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "HARNESS_EVALUATION_AGENTS",
        "class_name": "HarnessEvaluationAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HarnessEvaluationAgent"],
    },
  ],
  "workflows": [
    {
      "name": "holon-harness-evaluation-workflow",
      "binding": "THINK_EVALUATION_WORKFLOW",
      "class_name": "HarnessEvaluationWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
