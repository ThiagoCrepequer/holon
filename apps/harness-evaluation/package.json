{
  "name": "@holon/harness-evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "wrangler types --check && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/think": "catalog:",
    "@holon/contracts": "workspace:*",
    "@holon/evaluation": "workspace:*",
    "@holon/model": "workspace:*",
    "agents": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
